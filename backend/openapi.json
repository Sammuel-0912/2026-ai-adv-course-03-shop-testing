    "/api/coupons/preview": {
      "post": {
        "tags": [
          "Coupons"
        ],
        "summary": "優惠券試算",
        "description": "伺服器端重算金額，不信任前端傳入的價格。與建立訂單共用同一個 `calculateOrderAmount()` 純函式。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CouponPreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "試算結果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PreviewResult"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_ERROR` —— items 格式問題；`COUPON_MIN_SPEND_NOT_MET` —— 未達低消門檻",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`PRODUCT_NOT_FOUND` —— 商品不存在；`COUPON_NOT_FOUND` —— 優惠券不存在或已停用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`COUPON_USAGE_LIMIT_REACHED` —— 此優惠券已達使用次數上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "建立訂單",
        "description": "單一 transaction 內扣庫存、扣優惠券額度、建立訂單與 pending 通知；任一步失敗全部 rollback。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "訂單建立成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "message": {
                      "type": "string",
                      "example": "操作成功"
                    }
                  },
                  "required": [
                    "data",
                    "message"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_ERROR`／`COUPON_MIN_SPEND_NOT_MET`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "`UNAUTHORIZED` —— 請先登入",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`PRODUCT_NOT_FOUND`／`COUPON_NOT_FOUND`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`INSUFFICIENT_STOCK` —— 商品庫存不足；`COUPON_USAGE_LIMIT_REACHED` —— 券已達使用上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
