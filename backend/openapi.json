    "/api/ecpay/notify": {
      "post": {
        "tags": [
          "ECPay"
        ],
        "summary": "綠界 ReturnURL（server-to-server）",
        "description": "綠界背景通知。僅驗證 CheckMacValue 後回純文字，**不寫 DB**。本地開發時綠界打不到 localhost，屬預期行為。",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/EcpayCallbackForm"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CheckMacValue 驗證通過",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "1|OK"
                }
              }
            }
          },
          "400": {
            "description": "CheckMacValue 驗證失敗",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "0|CheckMacValueError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ecpay/result": {
      "post": {
        "tags": [
          "ECPay"
        ],
        "summary": "綠界 OrderResultURL（瀏覽器 form POST）",
        "description": "只做 302 轉址回前端訂單頁，**不寫 DB**。付款狀態由訂單頁輪詢 check-payment 取得。",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/EcpayCallbackForm"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "轉址回前端；查無對應訂單時轉回前端首頁",
            "headers": {
              "Location": {
                "description": "前端訂單頁網址",
                "schema": {
                  "type": "string",
                  "example": "http://localhost:5173/orders/1?payment=pending"
                }
              }
            }
          }
        }
      }
    }
  }
}
