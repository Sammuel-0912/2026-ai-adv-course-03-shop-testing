{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "openapi": "tsx scripts/generate-openapi.ts",
    "postman": "tsx scripts/generate-openapi.ts && tsx scripts/openapi-to-postman.ts",
    "postman:run": "cross-env NODE_OPTIONS= tsx scripts/generate-openapi.ts && cross-env NODE_OPTIONS= tsx scripts/openapi-to-postman.ts && newman run ../docs/postman_collection.json --env-var baseUrl=http://localhost:3001 --ignore-redirects"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
